<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: no cleartext, system CAs only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- BCH2 Electrum servers: system CAs only (no user-installed certs) -->
    <!-- Raw TCP (port 50001) uses java.net.Socket — not subject to this config -->
    <domain-config cleartextTrafficPermitted="false">
        <domain>electrum.bch2.org</domain>
        <domain>electrum2.bch2.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- BC2 explorer/API (fund path: getBC2Balance/AddressInfo/Utxos/History/broadcast use fetch()). -->
    <!-- Pin the Let's Encrypt ROOTS, not the ~90-day leaf: this defeats a rogue/ -->
    <!-- compromised non-LE CA (the real MITM threat) while surviving LE leaf and -->
    <!-- intermediate rotation. bc2mempool.com chains to ISRG Root X2 (verified -->
    <!-- 2026-08-03); X1 is pinned as a backup in case a future cert uses the RSA root. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">bc2mempool.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set>
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin><!-- ISRG Root X2 -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin><!-- ISRG Root X1 (backup) -->
        </pin-set>
    </domain-config>
</network-security-config>
